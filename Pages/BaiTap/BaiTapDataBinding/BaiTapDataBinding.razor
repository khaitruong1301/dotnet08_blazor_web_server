@page "/bai-tap-data-binding"


<div class="container">
    <h3>Bài tập chọn xe</h3>
    <div class="row">
        <div class="col-md-4">
            <img src="@imgHinh" alt="black-car" style="width: 300px;" />

        </div>
        <div class="col-md-8">
            <p>Chọn màu xe:</p>
            <button class="btn btn-primary" @onclick="@((e) => ChonXe("black"))">Đen</button>
            <button class="btn btn-secondary" @onclick="@((e) => ChonXe("silver"))">Trắng</button>
            <button class="btn btn-success" @onclick="@((e) => ChonXe("red"))">Đỏ</button>
        </div>
    </div>

</div>

@code {
    private string imgHinh {get;set;} = "/img/red-car.jpg";

    private void ChonXe(string mau)
    {
        imgHinh = $"/img/{mau}-car.jpg";
    }
}