@page "/baitapburger"

@inject BurgerStateService _burgerStateService;
@implements IDisposable

<h3>Burger Builder</h3>

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <h3>Burger</h3>
            <div class="breadTop"></div>
            @foreach (ToppingDTO item in _burgerStateService.Toppings)
            {
                if (item.Quantity > 0)
                {
                    for(int i=1;i<=item.Quantity;i++)
                    {
                        <div class="@item.Name.ToLower()"></div>
                    }
                }
            }
            <div class="breadBottom"></div>
        </div>
        <div class="col-md-6">
            <h3>Chọn thức ăn</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Thức ăn</th>
                        <th>Hành động</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ToppingDTO item in _burgerStateService.Toppings)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td><button class="btn btn-primary" @onclick="@(() => _burgerStateService.AddTopping(item.Name, 1))">Thêm</button>
                                @item.Quantity
                                <button class="btn btn-danger" @onclick="@(() => _burgerStateService.AddTopping(item.Name, -1))">Xóa</button>
                            </td>
                            <td>@item.Price</td>
                            <td>@item.Quantity</td>
                            <td>@(item.Price * item.Quantity)</td>
                        </tr>
                    }
                      
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        _burgerStateService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        _burgerStateService.OnChange -= StateHasChanged;
    }
}

